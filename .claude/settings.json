{
  "permissions": {
    "allow": [
      "Bash(php artisan test*)",
      "Bash(php artisan route:list*)",
      "Bash(php artisan migrate:status*)",
      "Bash(php artisan migrate --pretend*)",
      "Bash(php artisan serve*)",
      "Bash(php vendor/bin/pint*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)"
    ],
    "ask": [
      "Bash(php artisan migrate*)",
      "Bash(php artisan tinker*)",
      "Bash(php artisan db*)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(php artisan migrate:fresh*)",
      "Bash(php artisan migrate:reset*)",
      "Bash(php artisan migrate:refresh*)",
      "Bash(php artisan migrate:rollback*)",
      "Bash(php artisan db:wipe*)",
      "Bash(php artisan db:seed*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*TRUNCATE*)",
      "PowerShell(Remove-Item*-Recurse*)"
    ]
  }
}
